# Explicit key-free demo. Selecting DeepSeek never silently falls back to demo.
HARNESS_DEFAULT_PROVIDER=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Empty DATABASE_URL uses atomic local JSON storage. Run npm run db:migrate for PostgreSQL.
DATABASE_URL=
HARNESS_DATA_DIR=.harness

# Required before exposing the app beyond localhost. Use a random secret (at least 24 characters).
HARNESS_ACCESS_TOKEN=
# Set to the exact public origin behind a reverse proxy, e.g. https://harness.example.com.
HARNESS_PUBLIC_URL=

HARNESS_RUN_TIMEOUT_MS=120000
HARNESS_MAX_TOOL_CALLS=16
HARNESS_APPROVAL_TTL_MS=1800000
